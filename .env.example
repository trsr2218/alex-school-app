# Port the server listens on (most free hosts set this for you automatically).
PORT=3000

# How long a login session stays valid before the user must sign in again.
SESSION_TTL_HOURS=12

# Optional: where the JSON dataset lives. Set this to a mounted persistent disk
# (e.g. DATA_DIR=/var/data on Render) so the data survives restarts and
# redeploys. On first boot against an empty directory the app copies the seeded
# data/vfu-data.json across, so it never starts blank. Leave unset to use the
# repo's own data/ folder.
# DATA_DIR=/var/data

# Optional: only set these if you want MySQL-backed auth instead of the
# built-in JSON file store. Leave all of them unset to run on the
# zero-cost/JSON-only path (recommended for free-tier hosting).
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=vfu_db
